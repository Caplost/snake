  1→#!/bin/bash
       2→# E2E Screenshot Script for Snake Game
       3→# Records terminal session to prove game runs correctly
       4→# Usage: ./e2e-screenshot.sh
       5→#
       6→# Uses asciinema rec to produce proper .cast files (asciinema v2 format).
       7→# Falls back to asciinema cat ( piping output ) if rec is not available.
       8→# The script command is NOT used because it produces typescript format,
       9→# not asciinema .cast format.
      10→
      11→set -e
      12→
      13→SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
      14→PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
      15→SCREENSHOTS_DIR="$PROJECT_DIR/screenshots"
      16→
      17→# Create screenshots directory if it doesn't exist
      18→mkdir -p "$SCREENSHOTS_DIR"
      19→
      20→# Build snake binary first
      21→SNAKE_BINARY="$PROJECT_DIR/snake"
      22→if [[ ! -f "$SNAKE_BINARY" ]]; then
      23→    echo "Building snake binary..."
      24→    cd "$PROJECT_DIR" && go build -o snake ./cmd/snake
      25→fi
      26→
      27→# Generate timestamp
      28→TIMESTAMP=$(date +%Y%m%d-%H%M%S)
      29→OUTPUT_FILE="$SCREENSHOTS_DIR/${TIMESTAMP}-snake-gameplay.cast"
      30→
      31→echo "Recording snake game session to $OUTPUT_FILE"
      32→echo "Recording for 5 seconds (or until game exits)..."
      33→
      34→# Use asciinema rec if available, otherwise use asciinema cat
      35→if command -v asciinema &> /dev/null; then
      36→    # Primary: use asciinema rec for proper .cast format
      37→    # Note: timeout kills asciinema with SIGTERM, which causes a traceback in asciinema's
      38→    # async worker (known issue in asciinema Python). The file is still written correctly.
      39→    timeout 5 asciinema rec "$OUTPUT_FILE" --overwrite --cols 80 --rows 24 -c "$SNAKE_BINARY" 2>/dev/null || true
      40→else
      41→    echo "WARNING: asciinema not installed. Using fallback method."
      42→    echo "Install with: brew install asciinema (macOS) or pip install asciinema (Python)"
      43→    # Fallback: try using script with asciinema format via script + asciinema cat
      44→    # This produces a typescript, not asciinema, so we validate the output
      45→    TMP_TYPESCRIPT="$SCREENSHOTS_DIR/${TIMESTAMP}-typescript"
      46→    if [[ "$(uname)" == "Darwin" ]]; then
      47→        timeout 5 script -F "$TMP_TYPESCRIPT" "$SNAKE_BINARY" || true
      48→    else
      49→        timeout 5 script -f "$TMP_TYPESCRIPT" "$SNAKE_BINARY" || true
      50→    fi
      51→
      52→    if [[ -f "$TMP_TYPESCRIPT" ]]; then
      53→        FILE_SIZE=$(stat -f%z "$TMP_TYPESCRIPT" 2>/dev/null || stat -c%s "$TMP_TYPESCRIPT" 2>/dev/null)
      54→        if [[ "$FILE_SIZE" -gt 0 ]]; then
      55→            # Copy typescript as fallback .cast (not ideal but better than nothing)
      56→            cp "$TMP_TYPESCRIPT" "$OUTPUT_FILE"
      57→            echo "WARNING: Using typescript fallback format (not asciinema .cast)"
      58→            echo "Install asciinema for proper .cast format"
      59→        else
      60→            echo "ERROR: Recording file is empty (0 bytes)"
      61→            rm -f "$TMP_TYPESCRIPT"
      62→            exit 1
      63→        fi
      64→    else
      65→        echo "ERROR: Recording file not created"
      66→        exit 1
      67→    fi
      68→fi
      69→
      70→# Verify file is non-empty AND is valid asciinema format (starts with JSON header)
      71→if [[ -f "$OUTPUT_FILE" ]]; then
      72→    FILE_SIZE=$(stat -f%z "$OUTPUT_FILE" 2>/dev/null || stat -c%s "$OUTPUT_FILE" 2>/dev/null)
      73→    if [[ "$FILE_SIZE" -gt 0 ]]; then
      74→        # Check if file starts with valid asciinema JSON header
      75→        FIRST_CHAR=$(head -c 1 "$OUTPUT_FILE")
      76→        if [[ "$FIRST_CHAR" == "{" ]]; then
      77→            echo "SUCCESS: Recording saved to $OUTPUT_FILE ($FILE_SIZE bytes, asciinema format)"
      78→        else
      79→            echo "WARNING: Recording file exists but is not asciinema format (first char: $FIRST_CHAR)"
      80→            echo "File may be typescript format, not .cast format"
      81→        fi
      82→    else
      83→        echo "WARNING: Recording file is empty (0 bytes)"
      84→        exit 1
      85→    fi
      86→else
      87→    echo "ERROR: Recording file not created"
      88→    exit 1
      89→fi
      90→
      91→echo "Done! Recording: $OUTPUT_FILE"
      92→
  
