[2026-04-17T06:06:05.229Z] <<< Tool result (id=call_53a05e0e14574463852d572b)
  1→#!/bin/bash
       2→# E2E Screenshot Script for Snake Game
       3→# Records terminal session to prove game runs correctly
       4→# Usage: ./e2e-screenshot.sh
       5→#
       6→# Compatible with both Linux (script -f) and macOS (script -F)
       7→
       8→set -e
       9→
      10→SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
      11→PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
      12→SCREENSHOTS_DIR="$PROJECT_DIR/screenshots"
      13→
      14→# Create screenshots directory if it doesn't exist
      15→mkdir -p "$SCREENSHOTS_DIR"
      16→
      17→# Generate timestamp
      18→TIMESTAMP=$(date +%Y%m%d-%H%M%S)
      19→OUTPUT_FILE="$SCREENSHOTS_DIR/${TIMESTAMP}-snake-gameplay.cast"
      20→
      21→echo "Recording snake game session to $OUTPUT_FILE"
      22→echo "Recording for 3 seconds..."
      23→
      24→# Determine platform and appropriate script flags
      25→if [[ "$(uname)" == "Darwin" ]]; then
      26→    # macOS: use -F for flush (different semantics than Linux -f)
      27→    SCRIPT_FLAGS="-F"
      28→else
      29→    # Linux: use -f for force flush
      30→    SCRIPT_FLAGS="-f"
      31→fi
      32→
      33→# Check if asciinema is available (preferred)
      34→if command -v asciinema &> /dev/null; then
      35→    asciinema rec "$OUTPUT_FILE" --overwrite --timeout 3 &
      36→    PID=$!
      37→    sleep 3
      38→    kill $PID 2>/dev/null || true
      39→    echo "Recording saved to $OUTPUT_FILE"
      40→else
      41→    # Fallback: use script command with platform-specific flags
      42→    if command -v script &> /dev/null; then
      43→        script $SCRIPT_FLAGS -q "$OUTPUT_FILE" &
      44→        PID=$!
      45→        sleep 3
      46→        kill $PID 2>/dev/null || true
      47→        echo "Recording saved to $OUTPUT_FILE"
      48→    else
      49→        echo "Neither asciinema nor script command available"
      50→        echo "Please install asciinema: brew install asciinema"
      51→        exit 1
      52→    fi
      53→fi
      54→
      55→echo "Done! Recording: $OUTPUT_FILE"
      56→
  
