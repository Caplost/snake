[2026-04-17T06:11:10.430Z] <<< Tool result (id=call_function_77x1i0tfd102_1)
  1→#!/bin/bash
       2→# E2E Screenshot Script for Snake Game
       3→# Records terminal session to prove game runs correctly
       4→# Usage: ./e2e-screenshot.sh
       5→#
       6→# Fixed v4: Uses foreground timeout instead of background+kill
       7→# macOS script -F only flushes on session end, so kill prevented file content
       8→
       9→set -e
      10→
      11→SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
      12→PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
      13→SCREENSHOTS_DIR="$PROJECT_DIR/screenshots"
      14→
      15→# Create screenshots directory if it doesn't exist
      16→mkdir -p "$SCREENSHOTS_DIR"
      17→
      18→# Build snake binary first
      19→SNAKE_BINARY="$PROJECT_DIR/snake"
      20→if [[ ! -f "$SNAKE_BINARY" ]]; then
      21→    echo "Building snake binary..."
      22→    cd "$PROJECT_DIR" && go build -o snake ./cmd/snake
      23→fi
      24→
      25→# Generate timestamp
      26→TIMESTAMP=$(date +%Y%m%d-%H%M%S)
      27→OUTPUT_FILE="$SCREENSHOTS_DIR/${TIMESTAMP}-snake-gameplay.cast"
      28→
      29→echo "Recording snake game session to $OUTPUT_FILE"
      30→echo "Recording for 5 seconds (or until game exits)..."
      31→
      32→# Run snake inside script session with timeout (foreground)
      33→# This ensures .cast file is properly flushed when session ends
      34→if [[ "$(uname)" == "Darwin" ]]; then
      35→    # macOS: use -F for flush
      36→    timeout 5 script -F "$OUTPUT_FILE" "$SNAKE_BINARY" || true
      37→else
      38→    # Linux: use -f for force flush
      39→    timeout 5 script -f "$OUTPUT_FILE" "$SNAKE_BINARY" || true
      40→fi
      41→
      42→# Verify file is non-empty
      43→if [[ -f "$OUTPUT_FILE" ]]; then
      44→    FILE_SIZE=$(stat -f%z "$OUTPUT_FILE" 2>/dev/null || stat -c%s "$OUTPUT_FILE" 2>/dev/null)
      45→    if [[ "$FILE_SIZE" -gt 0 ]]; then
      46→        echo "SUCCESS: Recording saved to $OUTPUT_FILE ($FILE_SIZE bytes)"
      47→    else
      48→        echo "WARNING: Recording file is empty (0 bytes)"
      49→        exit 1
      50→    fi
      51→else
      52→    echo "ERROR: Recording file not created"
      53→    exit 1
      54→fi
      55→
      56→echo "Done! Recording: $OUTPUT_FILE"
      57→
  
