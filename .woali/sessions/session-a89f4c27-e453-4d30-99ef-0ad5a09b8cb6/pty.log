[2026-04-17T09:06:19.152Z] <<< Tool result (id=call_259f051c23f2458ea0127702)
  1→package game
       2→
       3→import (
       4→	"fmt"
       5→	"math/rand"
       6→	"sync"
       7→	"time"
       8→
       9→	"snake/internal/constants"
      10→	"snake/internal/food"
      11→	"snake/internal/snake"
      12→
      13→	"github.com/nsf/termbox-go"
      14→)
      15→
      16→type Game struct {
      17→	score    int
      18→	gameOver bool
      19→	snake    *snake.Snake
      20→	food     *food.Food
      21→	mu       sync.Mutex
      22→}
      23→
      24→func New() *Game {
      25→	s := snake.New(constants.GridSize/2, constants.GridSize/2)
      26→	f := food.New(0, 0)
      27→	f.Generate(constants.GridSize, s)
      28→	return &Game{
      29→		snake: s,
      30→		food:  f,
      31→	}
      32→}
      33→
      34→func (g *Game) Score() int {
      35→	return g.score
      36→}
      37→
      38→func (g *Game) GameOver() bool {
      39→	g.mu.Lock()
      40→	defer g.mu.Unlock()
      41→	return g.gameOver
      42→}
      43→
      44→func (g *Game) setGameOver(val bool) {
      45→	g.mu.Lock()
      46→	g.gameOver = val
      47→	g.mu.Unlock()
      48→}
      49→
      50→func (g *Game) handleKeyEvent(ev termbox.Event) {
      51→	if ev.Type != termbox.EventKey {
      52→		return
      53→	}
      54→	switch ev.Key {
      55→	case termbox.KeyArrowUp:
      56→		g.trySetDirection(snake.Point{X: 0, Y: -1})
      57→	case termbox.KeyArrowDown:
      58→		g.trySetDirection(snake.Point{X: 0, Y: 1})
      59→	case termbox.KeyArrowLeft:
      60→		g.trySetDirection(snake.Point{X: -1, Y: 0})
      61→	case termbox.KeyArrowRight:
      62→		g.trySetDirection(snake.Point{X: 1, Y: 0})
      63→	case termbox.KeyCtrlC, termbox.KeyEsc:
      64→		g.setGameOver(true)
      65→		return
      66→	}
      67→	switch ev.Ch {
      68→	case 'w', 'W':
      69→		g.trySetDirection(snake.Point{X: 0, Y: -1})
      70→	case 's', 'S':
      71→		g.trySetDirection(snake.Point{X: 0, Y: 1})
      72→	case 'a', 'A':
      73→		g.trySetDirection(snake.Point{X: -1, Y: 0})
      74→	case 'd', 'D':
      75→		g.trySetDirection(snake.Point{X: 1, Y: 0})
      76→	case 'r', 'R':
      77→		if g.GameOver() {
      78→			g.reset()
      79→		}
      80→	}
      81→}
      82→
      83→func (g *Game) trySetDirection(d snake.Point) {
      84→	g.mu.Lock()
      85→	defer g.mu.Unlock()
      86→	if g.snake.CheckReverseDirection(d) {
      87→		return
      88→	}
      89→	g.snake.SetDirection(d)
      90→}
      91→
      92→func (g *Game) Update() {
      93→	if g.GameOver() {
      94→		return
      95→	}
      96→
      97→	if g.snake.CheckWallCollision(constants.GridSize) || g.snake.CheckSelfCollision() {
      98→		g.setGameOver(true)
      99→		return
     100→	}
     101→
     102→	head := g.snake.Head()
     103→	foodPos := g.food.Position()
     104→	if head.X == foodPos.X && head.Y == foodPos.Y {
     105→		g.snake.Grow()
     106→		g.score += 10
     107→		g.food.Generate(constants.GridSize, g.snake)
     108→	} else {
     109→		g.snake.Move()
     110→	}
     111→}
     112→
     113→func (g *Game) Render() {
     114→	termbox.Clear(termbox.ColorDefault, termbox.ColorDefault)
     115→
     116→	// Draw corners
     117→	termbox.SetCell(0, 0, constants.CornerSymbol, termbox.ColorWhite, termbox.ColorDefault)
     118→	termbox.SetCell(constants.GridSize, 0, constants.CornerSymbol, termbox.ColorWhite, termbox.ColorDefault)
     119→	termbox.SetCell(0, constants.GridSize, constants.CornerSymbol, termbox.ColorWhite, termbox.ColorDefault)
     120→	termbox.SetCell(constants.GridSize, constants.GridSize, constants.CornerSymbol, termbox.ColorWhite, termbox.ColorDefault)
     121→
     122→	// Draw horizontal borders (top and bottom)
     123→	for x := 1; x < constants.GridSize; x++ {
     124→		termbox.SetCell(x, 0, constants.HorizontalBorder, termbox.ColorWhite, termbox.ColorDefault)
     125→		termbox.SetCell(x, constants.GridSize, constants.HorizontalBorder, termbox.ColorWhite, termbox.ColorDefault)
     126→	}
     127→	// Draw vertical borders (left and right)
     128→	for y := 1; y < constants.GridSize; y++ {
     129→		termbox.SetCell(0, y, constants.VerticalBorder, termbox.ColorWhite, termbox.ColorDefault)
     130→		termbox.SetCell(constants.GridSize, y, constants.VerticalBorder, termbox.ColorWhite, termbox.ColorDefault)
     131→	}
     132→
     133→	for _, p := range g.snake.Body() {
     134→		termbox.SetCell(p.X+1, p.Y+1, constants.SnakeSymbol, termbox.ColorYellow, termbox.ColorDefault)
     135→	}
     136→
     137→	foodPos := g.food.Position()
     138→	termbox.SetCell(foodPos.X+1, foodPos.Y+1, constants.FoodSymbol, termbox.ColorRed, termbox.ColorDefault)
     139→
     140→	if g.GameOver() {
     141→		msg := fmt.Sprintf("Game Over! Score: %d. Press R to restart", g.score)
     142→		for i, c := range msg {
     143→			termbox.SetCell(constants.GridSize/2-10+i, constants.GridSize/2, c, termbox.ColorYellow, termbox.ColorDefault)
     144→		}
     145→	}
     146→
     147→	scoreMsg := fmt.Sprintf("Score: %d", g.score)
     148→	for i, c := range scoreMsg {
     149→		termbox.SetCell(2+i, 0, c, termbox.ColorWhite, termbox.ColorDefault)
     150→	}
     151→
     152→	termbox.Flush()
     153→}
     154→
     155→func (g *Game) reset() {
     156→	rand.Seed(time.Now().UnixNano())
     157→	g.mu.Lock()
     158→	g.snake = snake.New(constants.GridSize/2, constants.GridSize/2)
     159→	g.food.Generate(constants.GridSize, g.snake)
     160→	g.score = 0
     161→	g.gameOver = false
     162→	g.mu.Unlock()
     163→}
     164→
     165→func (g *Game) Run() {
     166→	if err := termbox.Init(); err != nil {
     167→		panic(err)
     168→	}
     169→	defer termbox.Close()
     170→	termbox.SetInputMode(termbox.InputEsc)
     171→	g.reset()
     172→
     173→	ticker := time.NewTicker(time.Duration(constants.TickMs) * time.Millisecond)
     174→	defer ticker.Stop()
     175→
     176→	for {
     177→		g.Render()
     178→
     179→		// Event-driven input (blocking)
     180→		ev := termbox.PollEvent()
     181→		g.handleKeyEvent(ev)
     182→
     183→		// Check for exit
     184→		if g.GameOver() {
     185→			// Wait for user to press R to restart or Esc/Ctrl+C to exit
     186→			for {
     187→				ev := termbox.PollEvent()
     188→				if ev.Type == termbox.EventKey {
     189→					if ev.Ch == 'r' || ev.Ch == 'R' {
     190→						g.reset()
     191→						break
     192→					}
     193→					if ev.Key == termbox.KeyCtrlC || ev.Key == termbox.KeyEsc {
     194→						return
     195→					}
     196→				}
     197→			}
     198→		}
     199→
     200→		<-ticker.C
     201→		g.Update()
     202→	}
     203→}
     204→
  
